__pycache__/
*.pyc
# state/ is runtime scratch (event SQLite, sensor temp). The tree ships
# no state; code mkdirs what it needs. Never commit scratch.
state/
# Canary self-test/probe receipts are per-run machine artifacts: verify_slo
# reads them from the live dir, but they are never committed (one file per
# run would spam history). Hand-recorded evidence receipts (e.g.
# deploy/receipts/ag-sentinel-release.json) stay tracked deliberately.
deploy/receipts/ag-fabric-canary-*.json
# Delivery canary receipts: per-run, sha256-attested artifacts produced by
# the external Telegram renderer (or the --synthesize-receipt test path).
# Same rule as state canary receipts: never committed; live evidence only.
deploy/delivery-receipts/
# v0.5 shadow rollout receipts: per-run JSON produced by
# scripts/ag_v05_shadow_rollout.py. Hand-recorded evidence receipts
# (e.g. deploy/receipts/ag-sentinel-release.json) stay tracked deliberately.
deploy/receipts/ag-v05-shadow-*.json
.env
.DS_Store
Thumbs.db
*.log
.venv/
