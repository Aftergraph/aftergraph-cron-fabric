{
  "schema_version": "cron-coverage-policy/1.0",
  "topology_contract": {
    "repo": "Aftergraph/after-graph-governance",
    "path": "docs/platform-topology/2.0.json"
  },
  "principle": "Cron Fabric observes topology roles; it does not duplicate repository identity or grant authority.",
  "principle_v05": "v0.5 adds four fabric concern sensors (Truth / Liveness / Provenance / Research-freeze). Each sensor reads its scope from a canonical machine-readable policy under contracts/ \u2014 no sensor code may hardcode repository lists.",
  "fabric_concerns": {
    "truth_queue_integrity": {
      "policy": "contracts/queue-policy.yaml",
      "sensor": "ag-merge-queue-stall",
      "schedule": "every 2h",
      "disposition": "notify_on_stall"
    },
    "org_suite_liveness": {
      "policy": "module-level CORE_REPOS in scripts/sensors/org_suite_liveness.py (overridable when org suite is canonically published elsewhere)",
      "sensor": "ag-org-suite-liveness",
      "schedule": "every 6h",
      "disposition": "notify_on_degraded_or_missed"
    },
    "public_provenance": {
      "policy": "contracts/sources.yaml (PROVENANCE_PAIRS in sensor)",
      "sensor": "ag-public-provenance",
      "schedule": "every 6h",
      "disposition": "notify_on_stale_pin"
    },
    "research_freeze_integrity": {
      "policy": "contracts/freeze-manifest.yaml + contracts/freeze-amendments.yaml",
      "sensor": "ag-research-freeze-watch",
      "schedule": "every 6h",
      "disposition": "notify_on_breach_without_amendment"
    }
  },
  "concerns": {
    "org_truth": {
      "roles": [
        "canonical-contracts",
        "organization-community",
        "scheduled-observation-fabric"
      ],
      "disposition": "notify_on_drift"
    },
    "authority": {
      "roles": [
        "normative-authority",
        "runtime-enforcement"
      ],
      "disposition": "notify_on_semantic_drift"
    },
    "execution": {
      "roles": [
        "agent-runtime",
        "durable-execution"
      ],
      "disposition": "notify_on_semantic_drift"
    },
    "assurance": {
      "roles": [
        "verified-code-review",
        "continuity-containment-verification",
        "temporary-verification-fixture",
        "skill-portability-benchmark"
      ],
      "disposition": "notify_on_verification_change"
    },
    "research": {
      "roles": [
        "research-assurance",
        "continuity-contract"
      ],
      "disposition": "deep_audit_on_claim_change"
    },
    "models_capabilities": {
      "roles": [
        "capability-supply-chain",
        "model-rnd-methodology",
        "model-program",
        "model-lifecycle-registry",
        "skill-compatibility-contract"
      ],
      "disposition": "deep_audit_on_relevant_change"
    },
    "experience": {
      "roles": [
        "primary-experience",
        "work-inference",
        "work-intelligence-experience",
        "human-operator-plane"
      ],
      "disposition": "notify_on_contract_mismatch"
    },
    "public_foundation": {
      "roles": [
        "public-front-door",
        "knowledge-plane",
        "brand-design-system"
      ],
      "disposition": "notify_on_provenance_or_source_drift"
    },
    "legacy": {
      "roles": [
        "legacy-migration-source"
      ],
      "disposition": "noise_gate_only"
    },
    "incubation": {
      "roles": [
        "assurance-incubation"
      ],
      "disposition": "state_only_no_product_alerts"
    }
  },
  "special_rules": {
    "temporary-verification-fixture": "Track lifecycle and disappearance; never infer permanent platform ownership.",
    "assurance-incubation": "Track topology/state only while INTERNAL HOLD; never emit public/product maturity alerts.",
    "legacy-migration-source": "Legacy transition concern; no new canonical Aftergraph responsibility may be inferred from AVC activity."
  }
}
